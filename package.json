{
  "name": "@tangjianfang/claudecode-statusline",
  "version": "2.0.0",
  "description": "Custom status line for Claude Code: shows model, output TPS, token/cost totals, git branch, context usage and prompt-cache health, plus a pricing updater",
  "main": "statusline.js",
  "bin": {
    "cc-statusline": "statusline.js",
    "pricing-updater": "pricing-updater.js"
  },
  "files": [
    "statusline.js",
    "pricing-updater.js",
    "pricing.json",
    "scripts/postinstall.js",
    "install.bat",
    "install.sh",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "scripts": {
    "check": "node --check statusline.js && node --check pricing-updater.js && node --check scripts/postinstall.js",
    "install": "node statusline.js --install",
    "update-pricing": "node pricing-updater.js",
    "pricing:list": "node pricing-updater.js --list",
    "demo": "node -e \"process.stdout.write('{}')\" | node statusline.js",
    "demo:subagent": "node -e \"const s=new Date(Date.now()-5*60*1000).toISOString();process.stdout.write(JSON.stringify({tasks:[{id:'t1',name:'Explore',type:'Explore',status:'running',tokenCount:50000,contextWindowSize:200000,startTime:s,effort:'high'},{id:'t2',name:'fix-bug',type:'general-purpose',status:'completed',tokenCount:120000,contextWindowSize:200000,startTime:s,effort:'medium'}]}))\" | node statusline.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "statusline",
    "status-line",
    "cli",
    "terminal",
    "cost",
    "tokens",
    "cost-tracking",
    "token-counter",
    "tps",
    "pricing",
    "litellm",
    "rate-limit",
    "prompt-cache"
  ],
  "engines": {
    "node": ">=16"
  },
  "license": "MIT",
  "author": "cc-statusline contributors",
  "homepage": "https://github.com/tangjianfang/claudecode-statusline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangjianfang/claudecode-statusline.git"
  },
  "bugs": {
    "url": "https://github.com/tangjianfang/claudecode-statusline/issues"
  }
}
